# Copy to production/.env

APP_NAME="NethServer Pointer"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://pointer.example.com

# Domain served by Caddy, which gets its HTTPS certificate automatically.
SERVER_NAME=pointer.example.com

# Credentials for the admin account created the first time.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Postgres, created on first start of the postgres container.
DB_DATABASE=pointer
DB_USERNAME=pointer
DB_PASSWORD=

# Support server that brokers access to target machines.
POINTER_SUPPORT_HOST=
POINTER_SUPPORT_USER=pointer
POINTER_SUPPORT_PORT=
# Private key, as a multi-line value in double quotes.
POINTER_SUPPORT_IDENTITY=

# OAuth signing keys, as multi-line values in double quotes (the contents of storage/oauth-private.key and oauth-public.key).
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# kapa.ai retrieval API credentials
KAPA_API_KEY=
KAPA_PROJECT_ID=
